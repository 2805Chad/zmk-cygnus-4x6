#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp &kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp &kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q     &kp W     &kp E     &kp R     &kp T       &kp Y     &kp U     &kp I     &kp O     &kp P
                &hml LCTL A &hml LALT S &hml LGUI D &hml LSFT F &kp G   &kp H   &hmr RSFT J &hmr RGUI K &hmr RALT L &hmr RCTL SEMI
                &kp Z     &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA &kp DOT   &kp SLASH
                &lt 1 SPACE &lt 2 TAB  &kp ENTER    &lt 2 BSPC   &lt 1 DEL
            >;
        };

        lower_layer {
            bindings = <
                &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PERCENT   &kp CARET &kp AMPS  &kp ASTERISK &kp LPAR &kp RPAR
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5        &kp N6    &kp N7    &kp N8       &kp N9   &kp N0
                &kp GRAVE &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT      &kp LEFT  &kp DOWN  &kp UP       &kp RIGHT &kp PIPE
                &trans    &trans    &trans    &trans     &trans
            >;
        };

        raise_layer {
            bindings = <
                &kp ESCAPE &kp F1 &kp F2 &kp F3 &kp F4    &kp F5 &kp F6 &kp F7 &kp F8 &kp F9
                &kp TAB    &kp F10 &kp F11 &kp F12 &kp DELETE  &kp HOME &kp PG_DN &kp PG_UP &kp END &kp BSPC
                &kp CAPS   &kp INS &kp PSCRN &kp PAUSE &kp SLCK &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp ENTER
                &trans     &trans  &trans     &trans     &trans
            >;
        };
    };
};
